---
interface Props {
  href: string;
  target?: string;
}

const { href, target } = Astro.props;
---

<a href={href} target={target}>
  <slot />
</a>

<style>
  a[href] {
    opacity: 0.75;
    line-height: 1.25;
    text-decoration: underline;
  }
  a[href]:hover {
    text-decoration: underline;
    opacity: 1;
  }
</style>
