---
import { getCollection } from "astro:content";
import Introduction from "./Introduction.astro";
import { getSiteAssets } from "../vektor-content";

const siteAssets = getSiteAssets(await getCollection("pages"));
---

<script>
  import "./Animation.js";
</script>

<div class="pt-16 pb-6">
    <div class="container grid px-8">
      <div class="logo">
          <a-animation width={200} height={400} src={siteAssets.logoRive}></a-animation>
      </div>

      <Introduction />
    </div>
</div>

<style>
    .container {
        max-width: 1200px;
        grid-template-columns: 300px 1fr;
        align-items: center;
        justify-content: center;
        grid-gap: 100px;
    }
    .logo {
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 40px;
        height: 440px;
        --width: 100%;
        --height: auto;
    }

    .logo a-animation {
        filter: var(--logo-filter);
    }
    @media screen and (max-width: 640px) {
        .container {
            align-items: flex-start;
            grid-template-columns: 1fr;
            grid-template-rows: 250px auto;
            grid-gap: 0px;
        }
        .logo {
            height: 100%;
            --height: 300px;
        }
    }
</style>
