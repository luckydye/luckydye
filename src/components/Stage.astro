---
import Introduction from "./Introduction.astro";
---

<script>
  import "./Logo.js";
</script>

<div class="pt-16 pb-6">
    <div class="container grid px-8">
      <div class="logo">
          <canvas data-logo></canvas>
      </div>

      <Introduction />
    </div>
</div>

<style>
    .container {
        max-width: 1200px;
        grid-template-columns: 300px 1fr;
        align-items: center;
        justify-content: center;
        grid-gap: 100px;
    }
    .logo {
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 40px;
        height: 440px;
        --width: 100%;
        --height: auto;
    }

    .logo canvas {
        /* artboard plus bloom margin; keeps the logo itself at ~200x400 */
        aspect-ratio: 232 / 412;
        height: 458px;
        width: auto;
        flex: none;
        max-height: 100%;
        color: var(--text);
    }
    @media screen and (max-width: 640px) {
        .container {
            align-items: flex-start;
            grid-template-columns: 1fr;
            grid-template-rows: 250px auto;
            grid-gap: 0px;
        }
        .logo {
            height: 100%;
            --height: 300px;
        }
    }
</style>
