---
import Introduction from "./Introduction.astro";
---

<script>
  import "./Logo.js";
</script>

<div class="pt-16 pb-6">
    <div class="container grid px-8">
      <div class="logo">
          <canvas data-logo></canvas>
      </div>

      <Introduction />
    </div>
</div>

<style>
    .container {
        max-width: 1200px;
        grid-template-columns: 300px 1fr;
        align-items: center;
        justify-content: center;
        grid-gap: 100px;
    }
    .logo {
        position: relative; /* the bloom canvas is laid over the logo canvas */
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 40px;
        height: 440px;
        --width: 100%;
        --height: auto;
    }

    .logo canvas {
        /* artboard plus bloom margin; keeps the logo itself at ~200x400 */
        aspect-ratio: 232 / 412;
        height: 458px;
        width: auto;
        flex: none;
        max-height: 100%;
        color: var(--text);
        /* colour of the streaks (read by Logo.ts); the outline itself uses `color` */
        border-top-color: var(--logo-hot);
        border-bottom-color: var(--logo-metal-lo);
        border-left-color: var(--logo-metal-hi);
    }
    @media screen and (max-width: 640px) {
        .container {
            align-items: flex-start;
            grid-template-columns: 1fr;
            grid-template-rows: 250px auto;
            grid-gap: 0px;
        }
        .logo {
            height: 100%;
            --height: 300px;
        }
    }
</style>

<style is:global>
    /*
     * Light cast by the logo onto the page (see Logo.ts). The streaks are
     * light: on a dark page they are white-ish, on a light page white would
     * vanish, so they become orange.
     *
     * The overlay sits above the content but never takes input, so text near a
     * streak is lit too. It is a canvas drawn on the GPU and blended by the
     * compositor; nothing here is updated per frame.
     */
    :root {
        --logo-hot: #ff7a14;
        /* The outlines are metal: how dark it is in shadow, and how bright in reflections. */
        --logo-metal-lo: #4a4d51;
        --logo-metal-hi: #f6f5f3;
    }
    .logo-light {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        z-index: 50;
        color: var(--logo-hot);
        /*
         * Light is added on top, so it can only brighten the page, never darken
         * it (on a light page that leaves a soft pool of light, not a stain).
         */
        mix-blend-mode: plus-lighter;
        opacity: 0.3;
    }

    /*
     * The hero (logo and copy) is drawn by one canvas and one shader (Logo.ts).
     * The canvas sits over the layout grid with some room around it for the
     * bloom, and lets all input through. The empty .logo canvas only reserves
     * the logo's place.
     *
     * The copy is drawn a second time by that shader. The real text stays in the
     * DOM, selectable, searchable and readable by crawlers and screen readers;
     * once the canvas is ready only its fill is made transparent, so selection,
     * links and focus rings keep working, and the text is plain if WebGL is
     * unavailable.
     */
    .has-hero {
        position: relative;
    }
    .logo-hero {
        position: absolute;
        --hero-margin: 60px;
        left: calc(-1 * var(--hero-margin));
        top: calc(-1 * var(--hero-margin));
        width: calc(100% + 2 * var(--hero-margin));
        height: calc(100% + 2 * var(--hero-margin));
        pointer-events: none;
        color: var(--text);
        /* colours for the shader, which reads them back resolved (see Logo.ts) */
        border-top-color: var(--logo-hot);
        border-bottom-color: var(--logo-metal-lo);
        border-left-color: var(--logo-metal-hi);
    }
    html[data-glyphs] [data-glyphs-host] :is(h1, p, a) {
        -webkit-text-fill-color: transparent;
    }

    @media (prefers-color-scheme: dark) {
        :root {
            --logo-hot: var(--text);
            --logo-metal-lo: #181b1d;
            --logo-metal-hi: #c4cbcf;
        }
        .logo-light {
            color: color-mix(in srgb, var(--text) 75%, var(--accent));
            opacity: 1; /* dark mode can take the full strength */
        }
        /*
         * Near-white text can't get brighter, so the copy beside the logo rests a
         * little dimmer, like the unlit metal, and flares when light reaches it.
         */
        .caption :is(h1, p) {
            color: color-mix(in srgb, var(--text) 42%, var(--bg-0));
        }
    }
    @media print {
        .logo-light,
        .logo-hero {
            display: none;
        }
        html[data-glyphs] [data-glyphs-host] :is(h1, p, a) {
            -webkit-text-fill-color: currentColor;
        }
    }
</style>
