---
import Introduction from "./Introduction.astro";
---

<script>
  import "./Logo.js";
</script>

<div class="pt-16 pb-6">
    <div class="container grid px-8">
      <div class="logo">
          <canvas data-logo></canvas>
      </div>

      <Introduction />
    </div>
</div>

<style>
    .container {
        max-width: 1200px;
        grid-template-columns: 300px 1fr;
        align-items: center;
        justify-content: center;
        grid-gap: 100px;
    }
    .logo {
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 40px;
        height: 440px;
        --width: 100%;
        --height: auto;
    }

    .logo canvas {
        /* artboard plus bloom margin; keeps the logo itself at ~200x400 */
        aspect-ratio: 232 / 412;
        height: 458px;
        width: auto;
        flex: none;
        max-height: 100%;
        color: var(--text);
        /* colour of the streaks (read by Logo.ts); the outline itself uses `color` */
        border-top-color: var(--logo-hot);
    }
    @media screen and (max-width: 640px) {
        .container {
            align-items: flex-start;
            grid-template-columns: 1fr;
            grid-template-rows: 250px auto;
            grid-gap: 0px;
        }
        .logo {
            height: 100%;
            --height: 300px;
        }
    }
</style>

<style is:global>
    /*
     * Light cast by the logo onto the page (see Logo.ts). The streaks are
     * light: on a dark page they are white-ish, on a light page white would
     * vanish, so they become orange.
     *
     * The overlays sit above the content but never take input, so text near a
     * streak is lit too. They are canvases drawn on the GPU and blended by the
     * compositor; nothing here is updated per frame.
     */
    :root {
        --logo-hot: #ff7a14;
    }
    .logo-light,
    .logo-tint {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        z-index: 50;
        color: var(--logo-hot);
    }
    /* Light mode: an orange pool on the page... */
    .logo-light {
        opacity: 0.55;
    }
    /*
     * ...and a glint on the text. Added on top, the light vanishes into the
     * near-white page but lifts dark text towards orange.
     */
    .logo-tint {
        mix-blend-mode: plus-lighter;
        opacity: 0.6;
    }
    @media (prefers-color-scheme: dark) {
        :root {
            --logo-hot: var(--text);
        }
        .logo-light {
            /* additive: light on a dark page */
            mix-blend-mode: plus-lighter;
            color: color-mix(in srgb, var(--text) 75%, var(--accent));
            opacity: 1;
        }
        .logo-tint {
            /*
             * Near-white text can't get brighter, so the glint is a warm tint
             * instead: multiplying leaves the dark page alone and turns text
             * near the light cream.
             */
            mix-blend-mode: multiply;
            color: color-mix(in srgb, var(--accent) 40%, white);
            opacity: 1;
        }
    }
    @media print {
        .logo-light,
        .logo-tint {
            display: none;
        }
    }
</style>
